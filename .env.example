# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=kickreel-videos
R2_PUBLIC_URL=https://pub-XXXX.r2.dev          # or your custom domain

# Sanity
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production
SANITY_WRITE_TOKEN=skXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Team document IDs from your Sanity Studio
SANITY_TEAM_U11_ID=
SANITY_TEAM_U12_ID=

# Pipeline settings (optional)
CLIPS_PAD_SECONDS=15
CLIPS_OUTPUT_DIR=/tmp/kickreel-clips
